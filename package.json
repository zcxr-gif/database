{
  "name": "indgo-virtual-backend",
  "version": "1.0.0",
  "description": "API for IndGo Virtual Airline",
  "main": "server.js",
  "scripts": {
    "start": "node --expose-gc server.js",
    "build": "node scripts/build-va-terms-pdf.js",
    "build:routes": "node scripts/build-route-library.js",
    "build:terms": "node scripts/build-va-terms-pdf.js",
    "test:sites": "node scripts/test-va-site-builder.js && node scripts/test-session-cookies.js",
    "test:sites:browser": "node scripts/test-va-site-motion.js",
    "test:schema": "node scripts/test-schema-typekey.js",
    "test:crew": "node scripts/test-crew-shop-awards.js",
    "test:discord": "node scripts/test-crew-discord.js && node scripts/test-crew-discord-routes.js",
    "test:staff-pilot": "node scripts/test-crew-staff-pilot.js",
    "test:staff-apps": "node scripts/test-crew-staff-apps.js",
    "test:schema-sql": "bash scripts/test-crew-schema.sh",
    "test:forgot": "node scripts/test-crew-password-reset.js",
    "test:routes": "node scripts/test-route-library.js",
    "test:featured": "node scripts/test-crew-featured.js",
    "test:clubs": "node scripts/test-crew-clubs.js",
    "test:streaks": "node scripts/test-crew-streaks.js",
    "test:badges": "node scripts/test-crew-badges.js",
    "test:portal": "node scripts/test-va-portal-owner.js && node scripts/test-va-portal-naming.js && node scripts/test-va-portal-rename-plan.js",
    "test:portal:browser": "node scripts/test-va-portal-mobile.js && node scripts/test-va-submissions-mobile.js"
  },
  "keywords": [],
  "author": "Antony",
  "license": "ISC",
  "type": "commonjs",
  "engines": {
    "node": "24.x"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.940.0",
    "@aws-sdk/client-dynamodb": "^3.893.0",
    "@aws-sdk/client-s3": "^3.883.0",
    "@aws-sdk/lib-dynamodb": "^3.893.0",
    "axios": "^1.12.0",
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.8.0",
    "cors": "^2.8.5",
    "discord.js": "^14.25.1",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "fast-xml-parser": "^5.2.5",
    "googleapis": "^159.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.554.0",
    "mongoose": "^8.18.0",
    "multer": "^2.0.2",
    "multer-s3": "^3.0.1",
    "multer-storage-cloudinary": "^2.2.1",
    "papaparse": "^5.5.3",
    "passport": "^0.7.0",
    "passport-discord": "^0.1.4",
    "sharp": "^0.34.5"
  },
  "devDependencies": {
    "pdfkit": "^0.15.0"
  }
}
